# This .gitignore file is adapted from the official Unity .gitignore template
# (https://github.com/github/gitignore/blob/main/Unity.gitignore)

# ==================== Unity generated ====================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is
# also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you want to ignore the asset folder completely
# /[Aa]ssets/

# ==================== Autogenerated VS/MD/Consulo/Rider files ====================
# Visual Studio cache/options
.vs/
.vscode/

# JetBrains Rider
.idea/

# Mono auto generated files
mono_crash.*

# Unity3D generated meta files
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated native plugin files
*.apk
*.unitypackage

# ==================== OS / Editor leftovers ====================
# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp

# Windows
Desktop.ini

# ==================== Crash / log files ====================
# Crashlytics generated files
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treaming[Aa]ssets/aa.meta
/[Aa]ssets/[Ss]treaming[Aa]ssets/aa/*

# Codely CLI local tool cache
.codely-cli/
